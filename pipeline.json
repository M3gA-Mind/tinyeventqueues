{
  "$schema": "./schemas/pipeline.schema.json",
  "version": 1,
  "ingress": {
    "queue": "teq.ingress",
    "tombstone_ttl_ms": 2592000000,
    "batch_size": 64
  },
  "dead_letter": {
    "queue": "teq.dead"
  },
  "lanes": {
    "interactive": {
      "queue": "teq.lane.interactive",
      "concurrency": 8,
      "max_backlog": 1000
    },
    "actionable": {
      "queue": "teq.lane.actionable",
      "concurrency": 4,
      "max_backlog": 1000
    },
    "background": {
      "queue": "teq.lane.background",
      "concurrency": 2,
      "max_backlog": 1000,
      "cadence": "every(10m)",
      "budget": {
        "max_turns": 20,
        "backlog_ticks": 6
      }
    },
    "digest": {
      "queue": "teq.lane.digest",
      "concurrency": 1,
      "max_backlog": 1000
    }
  },
  "sources": [
    {
      "match": "web:*",
      "ack": "after_ingest",
      "weight": 50
    },
    {
      "match": "channel:*",
      "ack": "after_ingest",
      "weight": 0
    },
    {
      "match": "composio:*",
      "ack": "after_ingest",
      "weight": 0,
      "cadence": "instant",
      "budget": {
        "max_turns": 5,
        "backlog_ticks": 60,
        "degrade_debounce_ms": 10000
      }
    },
    {
      "match": "webhook:*",
      "ack": "after_ingest",
      "weight": -5,
      "cadence": "instant",
      "budget": {
        "max_turns": 10,
        "backlog_ticks": 60,
        "degrade_debounce_ms": 5000
      }
    },
    {
      "match": "*",
      "ack": "after_ingest",
      "weight": 0
    }
  ],
  "gate": {
    "allow_senders": [],
    "deny_senders": [],
    "direct_messages": true,
    "groups": true,
    "bot_loop": {
      "max_events": 20,
      "window_ms": 60000
    },
    "rate_limits": {
      "per_sender": {
        "capacity": 30,
        "refill_per_minute": 30
      },
      "per_conversation": {
        "capacity": 120,
        "refill_per_minute": 120
      },
      "per_source": {
        "capacity": 600,
        "refill_per_minute": 600
      }
    },
    "ambient": {
      "max_items": 50
    }
  },
  "coalesce": {
    "debounce_ms": 1500,
    "max_wait_ms": 10000,
    "control_prefixes": [
      "/"
    ]
  },
  "salience": {
    "weights": {
      "base": 25,
      "addressed": 50,
      "direct": 50,
      "known_contact": 15,
      "keyword": 20,
      "age_penalty_per_minute": 1,
      "max_age_penalty": 20
    },
    "keywords": [
      "urgent",
      "asap",
      "help",
      "error",
      "failed",
      "down",
      "outage"
    ],
    "known_contacts": [],
    "thresholds": {
      "interactive": 70,
      "actionable": 40,
      "background": 15
    },
    "borderline": {
      "low": 30,
      "high": 45,
      "budget_per_hour": 120
    },
    "habituation": {
      "window": 64,
      "window_ms": 3600000,
      "max_distance": 3,
      "decay_percent": 40
    }
  },
  "digest": {
    "max_items": 200,
    "max_wait_ms": 600000
  }
}
